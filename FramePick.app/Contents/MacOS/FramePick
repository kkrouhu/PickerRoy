#!/bin/zsh
set -e
contents_dir="$(cd "$(dirname "$0")/.." && pwd)"
project_dir="$(cd "$contents_dir/../.." && pwd)"
if [[ ! -x "$project_dir/.venv/bin/framepick" ]]; then
  osascript -e 'display dialog "FramePick is not installed. Run Install FramePick.command once." buttons {"OK"} default button "OK" with icon caution'
  exit 1
fi
cd "$project_dir"
exec "$project_dir/.venv/bin/framepick"

